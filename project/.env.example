POSTGRES_USER=verity
POSTGRES_PASSWORD=verity_local_only
POSTGRES_DB=verity
POSTGRES_PORT=55432
DATABASE_URL=postgresql://verity:verity_local_only@127.0.0.1:55432/verity
# Optional: an absolute directory for immutable uploaded original bytes.
# BLOB_DIRECTORY=/absolute/path/to/verity-blobs
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_AUDITOR_MODEL=gemini-3.8-flash

# Shared request concurrency in one worker process (not a token/output budget).
GEMINI_MAX_CONCURRENCY=6
# Optional actual project quotas from AI Studio; omit when unknown.
# GEMINI_RPM=
# GEMINI_INPUT_TPM=

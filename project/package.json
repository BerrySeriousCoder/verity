{
  "name": "verity",
  "private": true,
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "scripts": {
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck && pnpm typecheck:runtime",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "dev": "pnpm db:up && pnpm db:migrate && pnpm dev:apps",
    "dev:apps": "pnpm --parallel --filter @verity/api --filter @verity/web --filter @verity/worker dev",
    "build": "pnpm --filter @verity/web build",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter @verity/api test:integration",
    "db:migrate": "pnpm --filter @verity/database migrate",
    "test:e2e": "playwright test",
    "test:live": "pnpm --filter @verity/api test:live",
    "review:usage": "pnpm --filter @verity/database review:usage",
    "test:runtime": "node --test scripts/runtime/*.test.mjs",
    "test:fixtures": "node --import tsx --test scripts/fixtures.test.mts",
    "fixtures:generate": "node scripts/generate-demo-documents.mjs",
    "typecheck:runtime": "tsc -p scripts/tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.15.30",
    "prettier": "3.9.7",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
